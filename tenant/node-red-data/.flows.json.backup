    {
        "id": "init_func",
        "type": "function",
        "z": "ada91d9826e136b3",
        "name": "Init Token + Page",
        "func": "msg.api_token = msg.payload.data.api_token;\nmsg.page = 0;\nmsg.allResults = [];\n\nmsg.headers = {\n    \"app-key\": \"3aCGH6bNVav8acPvzA6/THVfK8rXIExI4d2RD8ZzoYo\",\n    \"app-token\": msg.api_token\n};\n\nmsg.url = \"https://apis.hrhl.com.my/api/v1.0/diagnosis.json?page=0\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 580,
        "wires": [
            [
                "diag_http"
            ]
        ]
    },
    {
        "id": "diag_http",
        "type": "http request",
        "z": "ada91d9826e136b3",
        "name": "Diagnosis API",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "x": 940,
        "y": 620,
        "wires": [
            [
                "loop_func"
            ]
        ]
    },
    {
        "id": "loop_func",
        "type": "function",
        "z": "ada91d9826e136b3",
        "name": "Loop Pages",
        "func": "if (!msg.payload || !msg.payload.data) {\n    node.error(\"Invalid API response\", msg);\n    return null;\n}\n\nlet data = msg.payload.data;\n\nif (!msg.allResults) {\n    msg.allResults = [];\n}\n\nlet currentResults = Array.isArray(data.result) ? data.result : [];\n\n//node.warn(\"PAGE = \" + msg.page);\n//node.warn(\"RESULT COUNT PAGE INI = \" + currentResults.length);\n\nmsg.allResults = msg.allResults.concat(currentResults);\n\n//node.warn(\"TOTAL COLLECTED = \" + msg.allResults.length);\n\nif (msg.total_page === undefined) {\n    msg.total_page = data.total_page;\n}\n\n// kalau nak page 0 sampai 5\nif (msg.page < msg.total_page) {\n    msg.page = msg.page + 1;\n\n    msg.url = \"https://apis.hrhl.com.my/api/v1.0/diagnosis.json?page=\" + msg.page;\n\n    // SET BALIK REQUEST HEADER\n    msg.headers = {\n        \"app-key\": \"3aCGH6bNVav8acPvzA6/THVfK8rXIExI4d2RD8ZzoYo\",\n        \"app-token\": msg.api_token\n    };\n\n    // GET request, kosongkan payload\n    msg.payload = \"\";\n\n    return [msg, null];\n} else {\n    msg.payload = {\n        total_page: msg.total_page,\n        total_records: msg.allResults.length,\n        result: msg.allResults\n    };\n\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1130,
        "y": 620,
        "wires": [
            [
                "diag_http"
            ],
            [
                "3d5fc755f7418b3d"
            ]
        ]
    },
