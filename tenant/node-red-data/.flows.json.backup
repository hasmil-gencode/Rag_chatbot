    {
        "id": "3d5fc755f7418b3d",
        "type": "function",
        "z": "ada91d9826e136b3",
        "name": "function 3",
        "func": "if (msg.payload && Array.isArray(msg.payload.result)) {\n    msg.payload = msg.payload.result\n        .sort((a, b) => a.id - b.id)\n        .map(x => ({\n            id: x.id,\n            name: x.name\n        }));\n}\n\nreturn msg;",
