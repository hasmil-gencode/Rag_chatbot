# Tenant service environment
# Copy to .env for local/prod or .env.staging for staging.

# ── Runtime ─────────────────────────────────────
NODE_ENV=production

# ── MongoDB ─────────────────────────────────────
# Docker compose default:
MONGODB_URI=mongodb://mongodb:27017/ragchatbot
# If using exposed staging Mongo from host:
# MONGODB_URI=mongodb://127.0.0.1:27020/ragchatbot

# Optional root credentials for docker-compose Mongo init.
# Leave blank if the Mongo container already has data and no auth.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ── Security ────────────────────────────────────
# Generate unique values per environment:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-tenant-secret
INTERNAL_KEY=change-this-to-a-long-random-internal-key

# ── Rate limit store ────────────────────────────
# memory = per-container only.
# mongo or persistent = shared through MongoDB rate_limits collection.
# redis = reserved hook for future Redis adapter.
RATE_LIMIT_STORE=memory

# ── Local automation services ───────────────────
N8N_USER=admin
N8N_PASSWORD=change-this-n8n-password

# ── Optional speech/transcription override ──────
# Used only if the app is configured to call a custom Whisper endpoint.
WHISPER_API_URL=

# ── Deployment notes ────────────────────────────
# Local tenant compose exposes app at:
#   http://localhost:1223 -> container port 3000
# Staging tenant compose exposes app at:
#   http://localhost:1225 -> container port 3000
#
# AI provider keys, OCR settings, S3 settings, Qdrant/Pinecone settings,
# SMTP, webhooks, TTS, and brand/logo settings are managed in the app UI
# and stored in MongoDB settings/provider_keys collections.
