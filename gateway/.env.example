# Gateway service environment
# Copy to .env for local/prod.

# ── Runtime ─────────────────────────────────────
NODE_ENV=production

PORT=4000

# ── MongoDB ─────────────────────────────────────
# Docker compose default:
MONGODB_URI=mongodb://mongodb:27017/gateway

# ── Security ────────────────────────────────────
# Generate unique value per environment:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-gateway-secret
# Optional override for gateway routing cookies.
# Default auto: Secure on production domains, non-Secure on localhost.
# COOKIE_SECURE=true
# COOKIE_SECURE=false

# ── Rate limiting ───────────────────────────────
# Gateway login lockouts are stored in MongoDB rate_limits collection so they
# survive Docker restarts and work across multiple gateway containers.

# ── Proxy & request limits ──────────────────────
# trust proxy: true|false|<hop count>|<comma subnet list>. Default true.
# req.secure / x-forwarded-proto need this behind Cloudflare+nginx.
# Login rate-limit IP comes from CF-Connecting-IP, not the spoofable req.ip.
TRUST_PROXY=true
# Max JSON request body (default 2mb).
JSON_BODY_LIMIT=2mb

# ── Deployment notes ────────────────────────────
# Local gateway compose exposes:
#   http://localhost:4000 -> container port 4000
#
# Tenant server records in Gateway UI should point to tenant service URLs,
# for example:
#   http://localhost:1223
# and must use the same INTERNAL_KEY configured in tenant/.env.
