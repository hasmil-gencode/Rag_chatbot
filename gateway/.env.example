# Gateway service environment
# Copy to .env for local/prod or .env.staging for staging.

# ── Runtime ─────────────────────────────────────
NODE_ENV=production

# Local gateway compose:
# PORT=4000
# Staging gateway compose:
# PORT=4001
PORT=4000

# ── MongoDB ─────────────────────────────────────
# Docker compose default:
MONGODB_URI=mongodb://mongodb:27017/gateway
# If using exposed staging Mongo from host:
# MONGODB_URI=mongodb://127.0.0.1:27019/gateway

# ── Security ────────────────────────────────────
# Generate unique value per environment:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-gateway-secret
# Optional override for gateway routing cookies.
# Default auto: Secure on production/staging domains, non-Secure on localhost.
# COOKIE_SECURE=true
# COOKIE_SECURE=false

# ── Rate limiting ───────────────────────────────
# Gateway login lockouts are stored in MongoDB rate_limits collection so they
# survive Docker restarts and work across multiple gateway containers.

# ── Deployment notes ────────────────────────────
# Local gateway compose exposes:
#   http://localhost:4000 -> container port 4000
# Staging gateway compose exposes:
#   http://localhost:4001 -> container port 4001
#
# Tenant server records in Gateway UI should point to tenant service URLs,
# for example:
#   http://localhost:1225
# and must use the same INTERNAL_KEY configured in tenant/.env.staging.
